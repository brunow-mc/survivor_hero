; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Survivor Hero"
run/main_scene="uid://okwsu3sadb1e"
config/features=PackedStringArray("4.6", "Forward Plus")

[audio]

buses/default_bus_layout="res://bus/default_bus_layout.tres"

[autoload]

GameStateGlobal="*res://autoload/game_state.gd"
InputManagerGlobal="*res://autoload/input_manager.gd"
XPManagerGlobal="*res://autoload/xp_manager.gd"
LevelUpManagerGlobal="*res://autoload/level_up_manager.gd"
##LevelUpDebug="*res://scripts/level_up_debug.gd"
AudioManagerGlobal="*res://autoload/audio_manager.gd"
SpawnManagerGlobal="*res://autoload/spawn_manager.gd"
PowerUpStatsGlobal="*res://autoload/power_up_stats.gd"
TargetTrackerGlobal="*res://autoload/target_tracker_global.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/mode=2
window/stretch/mode="canvas_items"

[global_group]

Player=""
Enemies=""
Power=""
PlayerHurtbox=""
PlayerHitbox=""
EnemyHurtbox=""
XPItems=""
EnemyHitbox=""

